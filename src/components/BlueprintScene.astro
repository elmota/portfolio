---
// Fondo sutil tipo "red de plano técnico": puntos conectados por líneas finas,
// en el mismo azul de acento del sitio. Decorativo, aria-hidden, nunca compite
// con el contenido. Respeta prefers-reduced-motion (un solo frame, sin loop).
---
<canvas id="blueprint-canvas" aria-hidden="true"></canvas>

<script>
  import * as THREE from 'three';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const canvas = document.getElementById('blueprint-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isSmall = window.innerWidth < 640;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
    camera.position.z = 11;

    const group = new THREE.Group();
    scene.add(group);

    // Nodos dispersos en un volumen poco profundo, como puntos de un esquema.
    const count = isSmall ? 34 : 64;
    const positions: THREE.Vector3[] = [];
    for (let i = 0; i < count; i++) {
      positions.push(
        new THREE.Vector3(
          (Math.random() - 0.5) * 14,
          (Math.random() - 0.5) * 9,
          (Math.random() - 0.5) * 4
        )
      );
    }

    const accent = new THREE.Color(0x00767d);

    const pointsGeo = new THREE.BufferGeometry().setFromPoints(positions);
    const pointsMat = new THREE.PointsMaterial({ color: accent, size: 0.045, transparent: true, opacity: 0.4 });
    group.add(new THREE.Points(pointsGeo, pointsMat));

    // Conecta cada nodo con sus vecinos más cercanos, como un esquema de red.
    const linePositions: number[] = [];
    const maxDist = isSmall ? 3.6 : 3.1;
    for (let i = 0; i < positions.length; i++) {
      let links = 0;
      for (let j = i + 1; j < positions.length && links < 2; j++) {
        if (positions[i].distanceTo(positions[j]) < maxDist) {
          linePositions.push(positions[i].x, positions[i].y, positions[i].z, positions[j].x, positions[j].y, positions[j].z);
          links++;
        }
      }
    }
    const lineGeo = new THREE.BufferGeometry();
    lineGeo.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));
    const lineMat = new THREE.LineBasicMaterial({ color: accent, transparent: true, opacity: 0.1 });
    group.add(new THREE.LineSegments(lineGeo, lineMat));

    function resize() {
      // clientWidth/clientHeight, no innerWidth/innerHeight: en mobile
      // innerWidth puede ser más ancho que el contenido real (el viewport de
      // layout vs. el visual), y como <canvas> es un elemento "replaced",
      // `inset:0` solo no lo estira — depende del width/height que fije acá.
      // Con eso mal, el canvas quedaba más ancho que la página y generaba
      // scroll horizontal fantasma.
      const w = document.documentElement.clientWidth;
      const h = document.documentElement.clientHeight;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener('resize', resize);

    group.rotation.x = 0.08;

    // Reacciona al cambio de lente: más denso/nítido en Ingeniería, más suave en Diseño.
    const temas: Record<string, { points: number; lines: number; size: number }> = {
      diseno: { points: 0.3, lines: 0.06, size: 0.055 },
      ambos: { points: 0.4, lines: 0.1, size: 0.045 },
      ingenieria: { points: 0.55, lines: 0.16, size: 0.04 },
    };
    document.addEventListener('lentechange', (e: Event) => {
      const lente = (e as CustomEvent<{ lente: string }>).detail?.lente ?? 'ambos';
      const t = temas[lente] ?? temas.ambos;
      if (reduceMotion) {
        pointsMat.opacity = t.points;
        lineMat.opacity = t.lines;
        pointsMat.size = t.size;
        renderer.render(scene, camera);
      } else {
        gsap.to(pointsMat, { opacity: t.points, size: t.size, duration: 0.6, ease: 'power2.out' });
        gsap.to(lineMat, { opacity: t.lines, duration: 0.6, ease: 'power2.out' });
      }
    });

    if (reduceMotion) {
      renderer.render(scene, camera);
    } else {
      gsap.registerPlugin(ScrollTrigger);

      // Deriva lenta, independiente del scroll: la señal de que esto está "vivo".
      gsap.to(group.rotation, { y: '+=0.25', duration: 40, repeat: -1, yoyo: true, ease: 'sine.inOut' });

      // Un único recorrido continuo ligado al scroll de toda la página,
      // no una animación repetida por sección.
      gsap.to(group.rotation, {
        x: 0.08 + 0.18,
        scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
      });
      gsap.to(camera.position, {
        z: 9,
        scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
      });

      renderer.setAnimationLoop(() => renderer.render(scene, camera));
    }
  }
</script>

<style>
  #blueprint-canvas {
    /* inset:0 ya estira el canvas al viewport entero; width/height en vw/vh
       son redundantes y en mobile terminan siendo más anchos que el
       contenido real (vw incluye lo que ocuparía una scrollbar), generando
       el scroll horizontal fantasma que esto evita. */
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.55;
  }
</style>

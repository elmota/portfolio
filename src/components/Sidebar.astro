---
// Sidebar fijo con los 8 items unificados (3 perfiles + 5 secciones), todos
// el mismo componente visual: bloques apilados que flotan sin contenedor
// propio, cada uno con su paleta fija (ver sidebarItems.ts). Vive en
// Base.astro, así que aparece en todas las páginas.
//
// Los perfiles (Diseño/Ambos/Ingeniería) son vistas alternativas del mismo
// hero — se eligen con un clic, no tiene sentido "scrollearlos". Las 5
// secciones, en cambio, son contenido real apilado en una sola página larga
// (como therawmaterials.com/work): el sidebar seguil el scroll (scrollspy)
// y un clic solo hace scroll hasta ahí, no oculta nada.
import { url } from '../lib/url';
import { sidebarItems } from '../lib/sidebarItems';

// Los perfiles se eligen con el selector en línea del Hero (visible también
// en mobile); el sidebar lista solo las secciones. Las paletas de todos
// viajan igual como JSON, porque aplicarEstilo las necesita aunque el item
// del perfil ya no exista en el menú.
const secciones = sidebarItems.filter((i) => i.tipo === 'seccion');
const paletas = Object.fromEntries(
  sidebarItems.map((i) => [i.id, { bg: i.bg, ink: i.ink, detail: i.detail, detailInk: i.detailInk }])
);
---

<aside class="sidebar">
  <div class="sidebar-top">
    <a class="logo" href={url()}>Alejandro Pérez</a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="sidebar-items" aria-label="Abrir menú">
      <span class="menu-toggle-grid" aria-hidden="true">
        <span style="background:#d36958"></span>
        <span style="background:#299dcd"></span>
        <span style="background:#bc2d75"></span>
        <span style="background:#d19f3a"></span>
      </span>
    </button>
  </div>

  <nav class="items" id="sidebar-items" aria-label="Secciones">
    <button
      type="button"
      class="item item-inicio"
      data-id="inicio"
      aria-pressed="false"
      style="--c:transparent;--ci:var(--page-ink)"
    >
      <span class="num">00</span>
      <span class="label">Inicio</span>
      <span class="item-tag">Quién soy y mis perfiles.</span>
    </button>
    {secciones.map((item) => (
      <>
        <button
          type="button"
          class="item"
          data-id={item.id}
          data-bg={item.bg}
          data-ink={item.ink}
          data-detail={item.detail}
          data-detail-ink={item.detailInk}
          aria-pressed="false"
          style={`--c:${item.bg};--ci:${item.ink}`}
        >
          <span class="blob-shift" aria-hidden="true">
            <span class="blob"></span>
          </span>
          <span class="num">{item.numero}</span>
          <span class="label">{item.etiqueta}</span>
          <span class="item-tag">{item.tagline}</span>
        </button>
      </>
    ))}
  </nav>
</aside>
<script type="application/json" id="paletas-data" set:html={JSON.stringify(paletas)} />

<script>
  const perfiles = ['diseno', 'ambos', 'ingenieria'];
  const secciones = ['casos', 'enfoque', 'skills', 'trayectoria', 'contacto'];
  const ids = [...perfiles, ...secciones];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLButtonElement>('[data-id]');
  const paletas: Record<string, { bg: string; ink: string; detail: string; detailInk: string }> = JSON.parse(
    document.getElementById('paletas-data')?.textContent ?? '{}'
  );
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const itemsNav = document.querySelector<HTMLElement>('.items');

  let ultimoPerfil = 'ambos'; // qué perfil restaurar al volver a scrollear hasta el Hero
  let ultimoActivo = 'ambos'; // último id activo, sea perfil o sección — para páginas sin ninguno de los dos (un caso de estudio)
  let observando = true; // se apaga durante un scroll-to-click, para que el observer no "pelee" con el clic
  let heroActivo: HTMLElement | null = null;
  let objetivosActivos: HTMLElement[] = [];

  // Fuente de verdad del scrollspy: el bloque (Hero o sección) que cruza la
  // línea central de la pantalla. Se recalcula entero cada vez en vez de
  // fiarse de qué entradas avisó el observer: en el borde entre dos
  // secciones ambas pueden contar como "visibles" y ganaba la que avisara
  // último (abrir el menú en Contacto lo dejaba en Trayectoria).
  function sincronizarActivo() {
    if (!observando) return;
    const centro = window.innerHeight / 2;
    for (const el of objetivosActivos) {
      const r = el.getBoundingClientRect();
      if (r.top <= centro && r.bottom > centro) {
        const id = el === heroActivo ? ultimoPerfil : el.id;
        if (id !== ultimoActivo) aplicarEstilo(id, true);
        return;
      }
    }
  }

  // Reactiva el scrollspy cuando el scroll programático realmente terminó
  // (scrollend), no a los 700 ms: en móvil el salto hasta Contacto recorre
  // ~11.000 px y dura más. Si el navegador no emite scrollend, vale el plazo.
  function reactivarTrasScroll(plazoMs = 2500) {
    let hecho = false;
    const fin = () => {
      if (hecho) return;
      hecho = true;
      window.removeEventListener('scrollend', fin);
      clearTimeout(t);
      observando = true;
      sincronizarActivo();
    };
    const t = setTimeout(fin, plazoMs);
    window.addEventListener('scrollend', fin, { once: true });
  }

  function cerrarMenu() {
    itemsNav?.classList.remove('abierto');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú');
    document.body.style.overflow = '';
  }
  menuToggle?.addEventListener('click', () => {
    const abierto = itemsNav?.classList.toggle('abierto');
    menuToggle.setAttribute('aria-expanded', String(!!abierto));
    menuToggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    // El desplegable es una hoja flotante sobre el contenido (mobile/tablet):
    // mientras está abierto, bloquea el scroll de atrás para que no se vea
    // cortado ni se pelee con el scroll de la página.
    document.body.style.overflow = abierto ? 'hidden' : '';
  });

  // Aplica el color/estado del item activo a TODA la página (bg/text/accent),
  // sin tocar qué contenido está visible — eso lo decide el scroll (secciones)
  // o el toggle del Hero (perfiles).
  function aplicarEstilo(id: string, actualizarHash: boolean) {
    const p = paletas[id];
    if (!p) return;
    ultimoActivo = id;
    // Solo las secciones tienen item en el menú: estando en un perfil
    // (arriba del todo), ninguno queda marcado.
    items.forEach((b) => {
      // "Inicio" queda activo mientras se está en el Hero (cualquier perfil).
      const esEste = b.dataset.id === id || (b.dataset.id === 'inicio' && perfiles.includes(id));
      b.classList.toggle('activo', esEste);
      b.setAttribute('aria-pressed', String(esEste));
    });

    const root = document.documentElement;
    root.style.setProperty('--bg', p.bg);
    root.style.setProperty('--text', p.ink);
    root.style.setProperty('--accent', p.detail);
    root.style.setProperty('--accent-ink', p.detailInk);

    document.documentElement.dataset.theme = id;
    document.dispatchEvent(new CustomEvent('lentechange', { detail: { lente: id } }));

    document.querySelectorAll<HTMLElement>('[data-lentes]').forEach((c) => {
      const propias = (c.dataset.lentes ?? '').split(' ');
      c.classList.toggle('destacado', id !== 'ambos' && propias.includes(id));
    });

    if (actualizarHash) history.replaceState(null, '', '#' + id);
  }

  // Perfiles: alternan entre los 3 paneles del Hero (nunca se "scrollean",
  // son la misma sección contada distinto) y siempre vuelven arriba.
  function seleccionarPerfil(id: string, actualizarHash: boolean) {
    ultimoPerfil = id;
    aplicarEstilo(id, actualizarHash);

    // Selector en línea del Hero: refleja el perfil activo (mismo estado que
    // los items del menú, pero visible también en mobile sin abrir nada).
    document.querySelectorAll<HTMLElement>('[data-perfil]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.perfil === id));
    });

    // El revelado de textos al mostrar el panel es CSS puro: se reinicia solo
    // cuando el panel pasa de display:none a visible (ver global.css).
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
      p.hidden = p.dataset.panel !== id;
    });
  }

  // Secciones: siempre están en la página (apiladas, se scrollean) — un clic
  // solo navega hasta ahí; el color/activo real lo confirma el scrollspy.
  function irASeccion(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    observando = false;
    aplicarEstilo(id, true);
    // Salto instantáneo (nada de recorrer 10.000 px de scroll): html tiene
    // scroll-behavior: smooth, así que hay que pedir 'instant' explícito.
    el.scrollIntoView({ behavior: 'instant', block: 'start' });
    reactivarTrasScroll(150);
    // En su lugar, una leve animación de "despliegue" en la sección destino.
    if (!reduceMotion) {
      el.classList.remove('desplegando');
      void el.offsetWidth; // reinicia la animación si se pulsa dos veces
      el.classList.add('desplegando');
      el.addEventListener('animationend', () => el.classList.remove('desplegando'), { once: true });
    }
  }

  // "Inicio": vuelve arriba del todo (Hero) conservando el último perfil.
  function irAInicio() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    observando = false;
    seleccionarPerfil(ultimoPerfil, true);
    window.scrollTo({ top: 0, behavior: 'instant' });
    reactivarTrasScroll(150);
  }

  // Si el perfil/sección elegido no existe en esta página (por ejemplo,
  // viendo el detalle de un caso: ahí no hay Hero ni secciones), navega al
  // home con ese hash en vez de quedarse sin hacer nada — un link sintético
  // para que la transición de página de Astro lo intercepte igual que un
  // clic normal.
  function navegarAHome(id: string) {
    const base = document.querySelector<HTMLAnchorElement>('.logo')?.getAttribute('href') ?? '/';
    const a = document.createElement('a');
    a.href = base.replace(/#.*$/, '') + (id ? '#' + id : '');
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    a.remove();
  }

  // Selector en línea: cambia de perfil sin mover el scroll (el panel está
  // justo debajo). Delegado en document: el Hero se vuelve a renderizar en
  // cada navegación, este script no.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-perfil]');
    if (!b?.dataset.perfil) return;
    seleccionarPerfil(b.dataset.perfil, true);
    // En pantallas chicas el panel queda bajo el pliegue: si es así, lo
    // trae a la vista para que el cambio no pase desapercibido.
    requestAnimationFrame(() => {
      const panel = document.querySelector<HTMLElement>('[data-panel]:not([hidden])');
      if (!panel) return;
      const top = panel.getBoundingClientRect().top;
      if (top > window.innerHeight * 0.6) {
        // Deja el selector completo a la vista, justo bajo la barra: el
        // panel sigue debajo, y se puede cambiar de perfil sin scrollear.
        const selector = document.querySelector<HTMLElement>('.perfil-switch');
        const barra = window.matchMedia('(max-width: 960px)').matches
          ? (document.querySelector<HTMLElement>('.sidebar-top')?.getBoundingClientRect().bottom ?? 0)
          : 0;
        const destino = selector ? selector.getBoundingClientRect().top - barra - 12 : top - 80;
        window.scrollBy({ top: destino, behavior: reduceMotion ? 'auto' : 'smooth' });
      }
    });
  });

  items.forEach((b) => {
    b.addEventListener('click', () => {
      const id = b.dataset.id ?? 'ambos';
      if (!document.querySelector('[data-hero]')) {
        navegarAHome(id === 'inicio' ? '' : id);
        cerrarMenu();
        return;
      }
      if (id === 'inicio') {
        irAInicio();
      } else if (perfiles.includes(id)) {
        seleccionarPerfil(id, true);
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      } else {
        irASeccion(id);
      }
      cerrarMenu();
    });
  });

  // Scrollspy: qué sección (o el propio Hero) ocupa la franja central de la
  // pantalla gobierna el color/activo del sidebar mientras se scrollea. Se
  // reconstruye en cada página (el sidebar persiste entre navegaciones, pero
  // el resto del documento —y por lo tanto el Hero y las secciones— es el de
  // la página nueva cada vez).
  let observerActivo: IntersectionObserver | null = null;

  function configurarPagina() {
    observerActivo?.disconnect();

    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const objetivos = [hero, ...secciones.map((id) => document.getElementById(id))].filter(
      (el): el is HTMLElement => !!el
    );
    heroActivo = hero;
    objetivosActivos = objetivos;

    if (objetivos.length) {
      // El observer solo avisa "algo cambió cerca del centro"; quién manda
      // lo decide sincronizarActivo().
      observerActivo = new IntersectionObserver(() => sincronizarActivo(), {
        rootMargin: '-45% 0px -45% 0px',
        threshold: 0,
      });
      objetivos.forEach((el) => observerActivo!.observe(el));
    }

    // Estado inicial de esta página: perfil o sección según el hash; sin
    // hash (u otra página sin ninguno de los dos), solo refleja el último
    // perfil elegido en los colores globales.
    const hashId = location.hash.slice(1);
    if (perfiles.includes(hashId)) {
      seleccionarPerfil(hashId, false);
    } else if (hero && secciones.includes(hashId) && document.getElementById(hashId)) {
      // El panel del Hero necesita algún perfil por debajo, pero el activo
      // real en el sidebar es la sección del hash — por eso aplicarEstilo
      // va DESPUÉS, pisando el color que seleccionarPerfil haya dejado.
      seleccionarPerfil(ultimoPerfil, false);
      aplicarEstilo(hashId, false);
      observando = false;
      requestAnimationFrame(() => {
        document.getElementById(hashId)?.scrollIntoView({ behavior: 'instant', block: 'start' });
        reactivarTrasScroll(700);
      });
    } else if (hero) {
      seleccionarPerfil(ultimoPerfil, false);
    } else {
      // Página sin Hero ni secciones (un caso de estudio): refleja lo último
      // que estaba activo en el sitio, sea perfil o sección.
      aplicarEstilo(ultimoActivo, false);
    }
  }

  // `astro:page-load` dispara también en la carga inicial, no solo tras
  // una transición — sirve como único punto de entrada.
  document.addEventListener('astro:page-load', configurarPagina);
</script>

---
// Contenido completo de un caso (ficha + cuerpo largo) — siempre su propia
// página (/casos/slug/), nunca un modal.
import Texto from './Texto.astro';
import { url } from '../lib/url';

interface Props {
  titulo: string;
  resumen: string;
  etiquetas: string[];
  problema: string;
  rol: string;
  proceso?: string;
  resultado: string;
  standalone?: boolean;
}
const { titulo, resumen, etiquetas, problema, rol, proceso, resultado, standalone = false } = Astro.props;
---

<article class="detalle">
  {standalone && <a class="back" href={url('#casos')}>← Todos los casos</a>}
  <div class="case-meta" class:list={{ 'with-back': standalone }}>{etiquetas.map((e) => <span class="tag">{e}</span>)}</div>
  <h1 class="case-detail-title">{titulo}</h1>
  <p class="lead">{resumen}</p>
  <div class="case" style="margin-top:32px">
    <dl>
      <dt>Problema</dt><dd><Texto text={problema} /></dd>
      <dt>Mi rol</dt><dd><Texto text={rol} /></dd>
      {proceso && (<><dt>Proceso</dt><dd><Texto text={proceso} /></dd></>)}
      <dt>Resultado</dt><dd><Texto text={resultado} /></dd>
    </dl>
  </div>
  <div class="body">
    <slot />
  </div>
</article>

{standalone && (
  <script>
    // "Volver" navega hacia atrás en el historial (si lo hay) en vez de
    // forzar siempre una entrada nueva — así la transición de salida usa la
    // animación "back" (ver global.css) y queda simétrica con la de entrada.
    // Delegado en `document` (no en el link): con View Transitions, el script
    // de una página de caso puede no re-ejecutarse al navegar de un caso a
    // otro, pero un listener en `document` sigue vivo en toda la sesión.
    if (!(window as any).__backNavInstalled) {
      (window as any).__backNavInstalled = true;
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest?.('a.back');
        if (link && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      });
    }
  </script>
)}

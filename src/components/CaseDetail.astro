---
// Contenido completo de un caso (ficha + cuerpo largo) — siempre su propia
// página (/casos/slug/), nunca un modal. El índice entre casos (CaseNav) se
// renderiza aparte, en el slot "fixed" de Base.astro: necesita quedar fuera
// de `.content` (que tiene container-type) para que su position:fixed sea
// relativo al viewport de verdad, no al contenido.
import Texto from './Texto.astro';
import { url } from '../lib/url';

interface Props {
  titulo: string;
  resumen: string;
  etiquetas: string[];
  problema: string;
  rol: string;
  proceso?: string;
  resultado: string;
  standalone?: boolean;
}
const { titulo, resumen, etiquetas, problema, rol, proceso, resultado, standalone = false } = Astro.props;
---

<article class="detalle">
  {standalone && <a class="back" href={url('#casos')}>← Todos los casos</a>}
  <div class="case-meta" class:list={{ 'with-back': standalone }}>{etiquetas.map((e) => <span class="tag">{e}</span>)}</div>
  <h1 class="case-detail-title">{titulo}</h1>
  <p class="lead">{resumen}</p>
  <div class="case" style="margin-top:32px">
    <dl>
      <dt>Problema</dt><dd><Texto text={problema} /></dd>
      <dt>Mi rol</dt><dd><Texto text={rol} /></dd>
      {proceso && (<><dt>Proceso</dt><dd><Texto text={proceso} /></dd></>)}
      <dt>Resultado</dt><dd><Texto text={resultado} /></dd>
    </dl>
  </div>
  <div class="body">
    <slot />
  </div>
</article>

{standalone && (
  <script>
    // "← Todos los casos" lleva SIEMPRE al listado (home, #casos), no "un paso
    // atrás": si se llegó desde otro caso (índice entre casos), history.back()
    // devolvería a ese caso. Se deja navegar el link (Astro hace la transición)
    // y se fuerza la dirección "back" para que la animación siga siendo la
    // simétrica de la de entrada (el caso sale hacia la derecha).
    // Delegado en `document` y en fase de captura: con View Transitions, el
    // script de una página de caso puede no re-ejecutarse al navegar de un caso
    // a otro, y el router de Astro (que escucha clics antes) navega en cuanto
    // ve el clic, así que la marca tiene que existir antes.
    if (!(window as any).__backNavInstalled) {
      (window as any).__backNavInstalled = true;
      let volviendo = false;
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement)?.closest?.('a.back')) volviendo = true;
      }, true);
      document.addEventListener('astro:before-preparation', (e) => {
        if (volviendo) (e as any).direction = 'back';
        volviendo = false;
      });
    }
  </script>
)}

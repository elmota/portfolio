---
// Card grande de la grilla de casos. Al hacer clic abre el detalle completo
// en el modal (ver CaseModal.astro); el contenido real vive en un
// <template data-case-tpl> que index.astro deja junto a esta card.
interface Props {
  slug: string;
  titulo: string;
  resumen: string;
  etiquetas: string[];
}
const { slug, titulo, resumen, etiquetas } = Astro.props;
---

<button type="button" class="case-card" data-open-case={slug} aria-haspopup="dialog">
  <span class="case-card-tags">{etiquetas.map((e) => <span class="tag">{e}</span>)}</span>
  <span class="case-card-title">{titulo}</span>
  <span class="case-card-resumen">{resumen}</span>
  <span class="case-card-open">Ver caso</span>
</button>

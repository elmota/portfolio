---
// Contenedor del modal/drawer de un caso. El contenido se clona desde los
// <template data-case-tpl="slug"> que cada CaseCard deja en la página
// (ver index.astro) y se inserta aquí al abrir.
import { url } from '../lib/url';
---

<div class="modal-backdrop" data-modal-backdrop data-base={url()} hidden>
  <div class="modal-sheet" role="dialog" aria-modal="true" aria-label="Detalle del caso" data-modal-sheet>
    <button type="button" class="modal-close" data-modal-close aria-label="Cerrar">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
    <div class="modal-content" data-modal-content></div>
    <p class="modal-permalink"><a href="#" data-modal-permalink>Abrir como página propia</a></p>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  const backdrop = document.querySelector('[data-modal-backdrop]');
  const sheet = document.querySelector('[data-modal-sheet]');
  const content = document.querySelector('[data-modal-content]');
  const closeBtn = document.querySelector('[data-modal-close]');
  const permalink = document.querySelector('[data-modal-permalink]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const base = backdrop?.dataset.base ?? '/';

  let lastFocused = null;
  const gsapMod = reduceMotion ? null : gsap;

  function focusablesIn(el) {
    return Array.from(el.querySelectorAll('a[href], button, [tabindex]:not([tabindex="-1"])'));
  }

  function openWith(slug) {
    const tpl = document.querySelector(`template[data-case-tpl="${slug}"]`);
    if (!tpl || !backdrop || !content) return;
    content.replaceChildren(tpl.content.cloneNode(true));
    permalink.href = `${base}casos/${slug}/`;
    lastFocused = document.activeElement;
    backdrop.hidden = false;
    document.body.style.overflow = 'hidden';

    if (gsapMod && !reduceMotion) {
      gsapMod.fromTo(backdrop, { opacity: 0 }, { opacity: 1, duration: 0.25, ease: 'power2.out' });
      gsapMod.fromTo(
        sheet,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.35, ease: 'power3.out' }
      );
    }
    sheet.scrollTop = 0;
    closeBtn.focus();
    document.addEventListener('keydown', onKeydown);
  }

  function close() {
    if (!backdrop || backdrop.hidden) return;
    const finish = () => {
      backdrop.hidden = true;
      content.replaceChildren();
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    };
    if (gsapMod && !reduceMotion) {
      let done = false;
      const finishOnce = () => { if (!done) { done = true; finish(); } };
      gsapMod.to(sheet, { opacity: 0, y: 16, duration: 0.2, ease: 'power2.in' });
      gsapMod.to(backdrop, { opacity: 0, duration: 0.22, ease: 'power2.in', onComplete: finishOnce });
      // Respaldo: si la animación no llega a completarse (pestaña en segundo plano,
      // rAF pausado, etc.), igual se cierra.
      setTimeout(finishOnce, 400);
    } else {
      finish();
    }
  }

  function onKeydown(e) {
    if (e.key === 'Escape') { close(); return; }
    if (e.key !== 'Tab') return;
    const focusables = focusablesIn(sheet);
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  document.querySelectorAll('[data-open-case]').forEach((card) => {
    card.addEventListener('click', () => openWith(card.dataset.openCase));
  });
  closeBtn?.addEventListener('click', close);
  backdrop?.addEventListener('click', (e) => { if (e.target === backdrop) close(); });
</script>

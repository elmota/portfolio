---
// El contenido del fold ahora vive junto al selector de "perfiles" del
// Sidebar (Diseño/Ambos/Ingeniería): Sidebar decide qué lente está activa
// (tema, URL, evento `lentechange`) y este componente solo muestra el panel
// correspondiente. Los tres textos son el verdadero contenido del home.
const lentes = [
  {
    id: 'diseno',
    rol: 'Product / UX Design',
    titular: 'Las soluciones se diseñan junto con el usuario.',
    bajada:
      'Research en terreno, Product Thinking y design systems para productos de dinero, minería y trámites públicos. La IA me acompaña a sintetizar, auditar y cubrir casos borde; las decisiones de diseño las tomo yo.',
    datos: [
      ['Entender a la persona', 'research y discovery en terreno antes de diseñar'],
      ['Decidir qué construir', 'Product Thinking y UX Strategy'],
      ['IA como compañero', 'síntesis de research y auditorías de UX, también para cubrir casos borde'],
    ],
  },
  {
    id: 'ambos',
    rol: 'Diseño + Código',
    titular: 'Llevar la solución desde la necesidad hasta su implementación.',
    bajada:
      '15 años en productos financieros, de minería y de gobierno. La misma persona define la experiencia y la construye. Los agentes de IA son un compañero: aceleran el proceso y ayudan con los casos borde; el criterio y la última revisión son míos.',
    datos: [
      ['15+', 'años en productos digitales'],
      ['Design + Code', 'de la estrategia al frontend en producción'],
      ['IA con criterio', 'agentes en research, prototipos, implementación y QA; la validación final es mía'],
    ],
  },
  {
    id: 'ingenieria',
    rol: 'UX / Design Engineering',
    titular: 'Integración de soluciones sin complicaciones.',
    bajada:
      'TypeScript, Next.js, Angular y React Native conectados a APIs REST y CI/CD. Los coding agents me acompañan en implementación y QA, útiles para casos borde; reviso cada cambio antes de producción.',
    datos: [
      ['TypeScript', 'Angular, Next.js y React Native'],
      ['REST APIs y CI/CD', 'integración y entrega continua'],
      ['Coding agents', 'acompañan la implementación y el QA; yo reviso cada cambio'],
    ],
  },
];

---

<section class="hero stage" data-hero>
  <div class="hero-resultado">
    <div class="hero-intro">
      <p class="hero-id">
        <strong>Alejandro Pérez Rocha</strong>
        <span>Product / UX Designer y Frontend Developer</span>
      </p>
      <h1>Más allá del diseño: hasta producción.</h1>
      <p class="lead">
        Hola, soy Alejandro. Llevo 15 años en productos donde equivocarse cuesta: banca, minería, trámites públicos. Parto del discovery y el diseño, y sigo hasta que el producto funciona en producción.
      </p>
      <p class="hero-meta">Santiago de Chile. Disponible de inmediato.</p>
      <ol class="ciclo" aria-label="Del discovery a producción">
        <li><span>1</span>Descubrir</li>
        <li><span>2</span>Diseñar</li>
        <li><span>3</span>Construir</li>
        <li><span>4</span>Producción</li>
      </ol>
      <div class="cta">
        <a class="btn btn-primary" href="#casos">Ver casos de estudio</a>
        <a class="btn" href="#contacto">Hablemos</a>
      </div>
    </div>

    {lentes.map((l) => (
      <div class="panel" data-panel={l.id} data-rol={l.rol} hidden={l.id !== 'ambos'}>
        <div class="fold hero-fold">
          <span class="blob-shift" aria-hidden="true">
            <span class="hero-blob"></span>
          </span>
          <p class="hero-eyebrow" data-reveal>{l.rol}</p>
          <h2 data-reveal>{l.titular}</h2>
          <p class="lead" data-reveal>{l.bajada}</p>
        </div>
        <ul class="specs" data-reveal>
          {l.datos.map(([t, d], i) => (
            <li>
              <span class="specs-num">{String(i + 1).padStart(2, '0')}</span>
              <strong>{t}</strong>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

---
// El contenido del fold ahora vive junto al selector de "perfiles" del
// Sidebar (Diseño/Ambos/Ingeniería): Sidebar decide qué lente está activa
// (tema, URL, evento `lentechange`) y este componente solo muestra el panel
// correspondiente. Los tres textos son el verdadero contenido del home.
const lentes = [
  {
    id: 'diseno',
    rol: 'Product / UX Design',
    titular: 'Resolver rápido no sirve si es el problema equivocado.',
    bajada:
      'Product Thinking, UX Strategy, research con usuarios —incluido discovery en terreno— y Design Systems: el trabajo que define qué construir antes de la primera pantalla. Así se armó el diseño UX/UI de Fraudia, y antes, proyectos de fintech, banca, minería y sector público.',
    datos: [
      ['Product Thinking', 'qué problema resolver, para quién y por qué'],
      ['Research con usuarios', 'discovery y validación en terreno'],
      ['Design Systems', 'coherencia a medida que crece el producto'],
    ],
  },
  {
    id: 'ambos',
    rol: 'Senior Product / UX Designer',
    titular: 'Una idea pierde valor cada vez que cambia de manos.',
    bajada:
      'Más de 15 años de productos digitales donde diseño e ingeniería frontend corren en paralelo: la misma mirada define la experiencia, la lleva a código y conecta usuarios, negocio y tecnología.',
    datos: [
      ['15+', 'de experiencia en productos digitales'],
      ['Multi-industria', 'fintech, banca, minería y sector público'],
      ['Design + Code', 'de la estrategia al frontend en producción'],
    ],
  },
  {
    id: 'ingenieria',
    rol: 'UX / Design Engineering',
    titular: 'Lo que deja de funcionar, deja de resolver el problema.',
    bajada:
      'TypeScript, Angular, Next.js y React Native conectados a CMS headless y APIs REST, con CI/CD y despliegue como parte del mismo proceso de diseño, no un paso aparte.',
    datos: [
      ['TypeScript', 'Angular, Next.js y React Native'],
      ['REST APIs', 'integración y configuración de servicios'],
      ['CI/CD y deploy', 'entrega continua y despliegue'],
    ],
  },
];
---

<section class="hero stage" data-hero>
  <div class="hero-resultado">
    {lentes.map((l) => (
      <div class="panel" data-panel={l.id} data-rol={l.rol} hidden={l.id !== 'ambos'}>
        <div class="fold hero-fold">
          <span class="blob-shift" data-blob-shift aria-hidden="true">
            <span class="hero-blob"></span>
          </span>
          <p class="hero-eyebrow" data-reveal>Alejandro Pérez Rocha · {l.rol}</p>
          <h1 data-reveal>{l.titular}</h1>
          <p class="lead" data-reveal>{l.bajada}</p>
        </div>
        <ul class="specs" data-reveal>
          {l.datos.map(([t, d], i) => (
            <li>
              <span class="specs-num">{String(i + 1).padStart(2, '0')}</span>
              <strong>{t}</strong>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="cta">
      <a class="btn btn-primary" href="#casos">Ver casos de estudio</a>
      <a class="btn" href="#contacto">Hablemos</a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Único momento orquestado del home: el panel que Sidebar ya resolvió como
  // activo aparece con una entrada suave; el resto del sitio no anima solo.
  if (!reduceMotion) {
    gsap.from('[data-panel]:not([hidden]) [data-reveal]', {
      opacity: 0, y: 14, duration: 0.5, stagger: 0.1, ease: 'power3.out',
    });
    gsap.from('.hero .cta', { opacity: 0, duration: 0.4, delay: 0.3, ease: 'power3.out' });
  }

  // El blob descansa abajo del fold y sigue la velocidad del scroll: sube
  // al scrollear hacia abajo y baja al scrollear hacia arriba, más cuanto
  // más rápido; al detenerse vuelve suave a su posición (loop de rAF).
  if (!reduceMotion) {
    let lastY = window.scrollY;
    let target = 0;
    let shift = 0;
    let raf = 0;
    const tick = () => {
      shift += (target - shift) * 0.14;
      target *= 0.9;
      document.querySelectorAll<HTMLElement>('[data-blob-shift]').forEach((el) => {
        el.style.transform = `translateY(${-shift}px)`;
      });
      raf = Math.abs(shift) > 0.2 || Math.abs(target) > 0.2 ? requestAnimationFrame(tick) : 0;
    };
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      target = Math.max(-140, Math.min(140, (y - lastY) * 3));
      lastY = y;
      if (!raf) raf = requestAnimationFrame(tick);
    }, { passive: true });
  }
</script>

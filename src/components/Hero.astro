---
// El contenido del fold ahora vive junto al selector de "perfiles" del
// Sidebar (Diseño/Ambos/Ingeniería): Sidebar decide qué lente está activa
// (tema, URL, evento `lentechange`) y este componente solo muestra el panel
// correspondiente. Los tres textos son el verdadero contenido del home.
import { sidebarItems } from '../lib/sidebarItems';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const d = getDict(lang);
const lentes = d.hero.lentes;
const perfiles = sidebarItems.filter((i) => i.tipo === 'perfil');
---

<section class="hero stage" data-hero>
  <div class="hero-resultado">
    <div class="hero-intro">
      <p class="hero-id">
        <strong>{d.hero.nombre}</strong>
        <span>{d.hero.cargo}</span>
        <span class="hero-meta">{d.hero.meta}</span>
      </p>
      <h1>{d.hero.titular}</h1>
      <p class="lead">
        {d.hero.lead}
      </p>
      <ol class="ciclo" aria-label={d.hero.cicloAria}>
        {d.hero.ciclo.map((paso, i) => <li><span>{i + 1}</span>{paso}</li>)}
      </ol>
    </div>

    <div class="perfil-switch" role="group" aria-labelledby="perfil-switch-title">
      <p class="perfil-switch-title" id="perfil-switch-title">{d.hero.switchTitle}<span class="perfil-switch-hint">{d.hero.switchHint}</span></p>
      <div class="perfil-switch-btns">
        {perfiles.map((p) => (
          <button
            type="button"
            class="perfil-btn"
            data-perfil={p.id}
            aria-pressed={p.id === 'ambos' ? 'true' : 'false'}
            style={`--c:${p.bg};--ci:${p.ink}`}
          >
            <strong>{d.items[p.id].etiqueta}</strong>
            <span>{d.items[p.id].tagline}</span>
          </button>
        ))}
      </div>
    </div>

    {lentes.map((l) => (
      <div class="panel" data-panel={l.id} data-rol={l.rol} hidden={l.id !== 'ambos'}>
        <div class="fold hero-fold">
          <span class="blob-shift" aria-hidden="true">
            <span class="hero-blob"></span>
          </span>
          <p class="hero-eyebrow" data-reveal>{l.rol}</p>
          <h2 data-reveal>{l.titular}</h2>
          <p class="lead" data-reveal>{l.bajada}</p>
        </div>
        <ul class="specs" data-reveal>
          {l.datos.map(([t, d], i) => (
            <li>
              <span class="specs-num">{String(i + 1).padStart(2, '0')}</span>
              <strong>{t}</strong>
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="cta">
      <a class="btn btn-primary" href="#casos">{d.hero.ctaCasos}</a>
      <a class="btn" href="#contacto">{d.hero.ctaContacto}</a>
    </div>
  </div>
</section>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import Texto from '../components/Texto.astro';
import Hero from '../components/Hero.astro';

// Cada caso abre siempre como página propia (/casos/<id>/, ver src/pages/casos/[id].astro),
// nunca en un modal — así que acá solo hace falta el listado, no el contenido renderizado.
const casos = (await getCollection('casos')).sort((a, b) => a.data.orden - b.data.orden);

// `lentes` indica con qué vista del hero se resalta cada grupo (diseno · ingenieria; ambos resalta todo)
const capacidades = [
  { titulo: 'Investigación y discovery', lentes: 'diseno', items: ['Research con usuarios', 'Pruebas de usuario', 'Discovery en terreno', 'Validación de hipótesis'] },
  { titulo: 'Estrategia y producto', lentes: 'diseno', items: ['Product Thinking', 'UX Strategy', 'Arquitectura de información', 'Definición de flujos'] },
  { titulo: 'Diseño', lentes: 'diseno', items: ['Product Design', 'UX/UI', 'Diseño de interacción', 'Prototipado', 'Design Systems'] },
  { titulo: 'Implementación frontend', lentes: 'ingenieria', items: ['TypeScript', 'JavaScript', 'Angular', 'Next.js', 'React Native', 'Tailwind CSS', 'WordPress'] },
  { titulo: 'Integración y entrega', lentes: 'ingenieria', items: ['CMS headless (Strapi)', 'REST APIs', 'Configuración de servicios', 'CI/CD', 'Despliegue'] },
  { titulo: 'IA en el proceso', lentes: 'diseno ingenieria', items: ['Research y auditorías con IA', 'Prototipos con coding agents', 'Implementación y QA'] },
];

const trayectoria = [
  { cuando: 'Desde mar. 2024', titulo: 'Fraudia', rol: 'Líder UX/UI Design y Front End Developer', texto: 'Diseño UX/UI y desarrollo frontend de un producto del sector financiero.' },
  { cuando: '—', titulo: 'Paybest', rol: 'Diseño de producto y desarrollo frontend', texto: 'Billetera digital: diseño de producto y desarrollo frontend.' },
  { cuando: 'Desde may. 2015', titulo: 'Base Dos', rol: 'Front End Architect / Designer Lead', texto: 'Arquitectura frontend, dirección de diseño y diseño UX para clientes financieros, entre ellos Banco Security (2017–2019).' },
  { cuando: '2011–2020', titulo: 'Banco de Chile', rol: 'Cuatro encargos distintos', texto: 'Portal de seguros, especificación de compatibilidad IE6, un sistema interno para la Teletón (2012–2018) y la app Mi Pago (React Native, 2020).' },
  { cuando: '2015', titulo: 'Porta SA', rol: 'Front End Developer', texto: '' },
  { cuando: '2013–2015', titulo: 'CodeBase Chile', rol: 'Front End Engineer', texto: '' },
  { cuando: '2010–2013', titulo: 'Imagemaker', rol: 'Diseñador y desarrollador web', texto: '' },
  { cuando: '2009–2010', titulo: 'monotono.cl', rol: 'Diseño web, diseño gráfico y desarrollo', texto: '' },
  { cuando: '2008–2013', titulo: 'Freelance', rol: 'Diseño y desarrollo de aplicaciones y sitios', texto: 'El punto de partida: diseño y código desde el primer día.' },
];

const formacion = [
  { anio: '2020', titulo: 'Diplomado en Diseño y Medición de Experiencia de Usuario en Entornos Digitales', lugar: 'Pontificia Universidad Católica de Chile' },
  { anio: '2014–2016', titulo: 'Analista Programador', lugar: 'INACAP' },
  { anio: '2011', titulo: 'Diplomado en Gestión de Proyectos Web', lugar: 'Universidad de Chile' },
  { anio: '2009–2010', titulo: 'Diplomado en Programación Web', lugar: 'Universidad del Pacífico' },
  { anio: '2005–2008', titulo: 'Diseño Gráfico', lugar: 'INACAP' },
];

// Espiral de "Cada versión es otra vuelta": 3 vueltas desde el centro hacia
// afuera. Las versiones (puntos, sin números) caen siempre sobre el mismo radio (arriba):
// cada vuelta vuelve al mismo punto, un poco más lejos y con más contexto.
const ESP = { cx: 210, cy: 210, r0: 16, r1: 176, vueltas: 3, pasos: 360 };
const espMax = ESP.vueltas * 2 * Math.PI;
const espPunto = (th: number) => {
  const r = ESP.r0 + (ESP.r1 - ESP.r0) * (th / espMax);
  const f = th - Math.PI / 2; // arranca arriba, avanza en sentido horario
  return { x: ESP.cx + r * Math.cos(f), y: ESP.cy + r * Math.sin(f) };
};
const espPts = Array.from({ length: ESP.pasos + 1 }, (_, i) => espPunto((espMax * i) / ESP.pasos));
const espLen = espPts.reduce<number[]>((acc, p, i) => {
  acc.push(i === 0 ? 0 : acc[i - 1] + Math.hypot(p.x - espPts[i - 1].x, p.y - espPts[i - 1].y));
  return acc;
}, []);
const espTotal = espLen[espLen.length - 1];
const espD = 'M' + espPts.map((p) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' L');
const espNodos = [0, 1, 2, 3].map((k, i) => {
  const th = k * 2 * Math.PI;
  const pt = espPunto(th);
  const idx = Math.round((th / espMax) * ESP.pasos);
  const desde = 8 + 40 * (espLen[idx] / espTotal); // % del rango de scroll en que aparece
  return { ...pt, desde: desde.toFixed(1), hasta: (desde + 4).toFixed(1), ultimo: i === 3 };
});
const espEnd = espPts[espPts.length - 1];
const espPrev = espPts[espPts.length - 6];
const espAng = Math.atan2(espEnd.y - espPrev.y, espEnd.x - espPrev.x);
const espFlecha = [
  [espEnd.x + 14 * Math.cos(espAng), espEnd.y + 14 * Math.sin(espAng)],
  [espEnd.x + 7 * Math.cos(espAng + Math.PI / 2), espEnd.y + 7 * Math.sin(espAng + Math.PI / 2)],
  [espEnd.x + 7 * Math.cos(espAng - Math.PI / 2), espEnd.y + 7 * Math.sin(espAng - Math.PI / 2)],
].map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
---

<Base>
  <Hero />

  <section id="casos" class="section">
    <div class="section-head fold">
      <span class="blob-shift" aria-hidden="true"><span class="hero-blob"></span></span>
      <h2>Casos de estudio</h2>
      <p class="section-intro">Productos donde la complejidad es el trabajo: dinero, maquinaria, trámites públicos y confianza.</p>
    </div>
    <div class="case-grid">
      {casos.map((caso) => (
        <CaseCard slug={caso.id} titulo={caso.data.titulo} resumen={caso.data.resumen} etiquetas={caso.data.etiquetas} />
      ))}
    </div>

    <div class="otros-proyectos">
      <h3>Otros proyectos</h3>
      <article class="card">
        <h3>Barrio Alonso de Córdova</h3>
        <p>Proyecto digital para un entorno de boutiques de moda, diseño, regalos y restaurantes.</p>
      </article>
    </div>
  </section>

  <section id="enfoque" class="section stage">
    <div class="section-head fold">
      <span class="blob-shift" aria-hidden="true"><span class="hero-blob"></span></span>
      <h2>Diseño que sabe cómo se construye</h2>
      <p class="section-intro">
        Los productos con los que suelo trabajar —dinero, maquinaria crítica, trámites de gobierno— son complejos y tienen poco margen de error. Entre el diseño y el código suele perderse fidelidad: una decisión de UX llega distinta al código, o una restricción técnica llega tarde al diseño. Se evita cuando ambos lados del trabajo los sostiene la misma persona, de principio a fin.
      </p>
    </div>
    <div class="grid2">
      <article class="card" data-lentes="diseno">
        <h3>Qué construir</h3>
        <p>Product Thinking y UX Strategy, antes de abrir una herramienta de diseño: qué problema resolver, para quién, y cómo se verá el éxito.</p>
      </article>
      <article class="card" data-lentes="ingenieria">
        <h3>Cómo construirlo</h3>
        <p>De la maqueta a producción y después: frontend, integración con REST APIs y despliegue con CI/CD, con criterio de implementación desde el primer boceto.</p>
      </article>
      <article class="card" data-lentes="diseno ingenieria">
        <h3>Donde ambos se cruzan</h3>
        <p>Lo que se diseña es lo que se implementa: menos traducciones entre etapas, y QA compartido con el equipo cuando hace falta.</p>
      </article>
      <article class="card" data-lentes="diseno ingenieria">
        <h3>La IA acompaña, el criterio decide</h3>
        <p>Es mi compañero en research, auditorías, prototipos, implementación y QA: acelera y ayuda a cubrir casos borde. Yo valido cada resultado, y un blueprint de producto con las decisiones documentadas mantiene al equipo y a los agentes con el mismo criterio.</p>
      </article>
    </div>

    <figure class="espiral">
      <figcaption>
        <h3>Cada versión es otra vuelta.</h3>
        <p>Lo que la gente hace con lo entregado abre el siguiente descubrir. Acompaño esas vueltas, no solo la primera.</p>
      </figcaption>
      <svg viewBox="0 0 420 420" role="img" aria-labelledby="espiral-t">
        <title id="espiral-t">Una espiral que se abre en cada vuelta: cada punto es una versión, y sigue.</title>
        <path class="vuelta" pathLength="1" d={espD} />
        {espNodos.map((n) => (
          <g class:list={['nodo', { ultimo: n.ultimo }]} style={`animation-range: cover ${n.desde}% cover ${n.hasta}%`}>
            <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={n.ultimo ? 8 : 6} />
          </g>
        ))}
        <polygon class="flecha" points={espFlecha} />
      </svg>
    </figure>
  </section>

  <section id="skills" class="section">
    <div class="section-head fold">
      <span class="blob-shift" aria-hidden="true"><span class="hero-blob"></span></span>
      <h2>De la investigación al código en producción</h2>
      <p class="section-intro">Incorporo IA y coding agents en el diseño, la implementación y el QA, siempre con criterio humano al frente.</p>
    </div>
    <div class="grid2">
      {capacidades.map((h) => (
        <div class="card" data-lentes={h.lentes}>
          <h3>{h.titulo}</h3>
          <ul class="chips">{h.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section id="trayectoria" class="section">
    <div class="section-head fold">
      <span class="blob-shift" aria-hidden="true"><span class="hero-blob"></span></span>
      <h2>Trayectoria</h2>
      <p class="section-intro">2008 — hoy</p>
    </div>
    <p class="sobre-mi">Empecé en diseño gráfico y programación en 2008, y con los años me quedé en el cruce entre ambos: donde una buena decisión de diseño se encuentra con una restricción técnica real. Me muevo mejor en productos donde equivocarse cuesta —dinero, identidad, regulación— y donde la claridad es una forma de cuidar al usuario.</p>
    <ol class="timeline">
      {trayectoria.map((t) => (
        <li>
          <span class="when">{t.pendiente ? <Texto text={t.cuando} /> : t.cuando}</span>
          <div>
            <h3>{t.titulo} <span class="rol">· {t.rol}</span></h3>
            {t.texto && <p>{t.texto}</p>}
          </div>
        </li>
      ))}
    </ol>

    <div class="section-head formacion-head">
      <h3>Formación</h3>
      <p class="section-intro">2005 — 2020</p>
    </div>
    <ol class="timeline">
      {formacion.map((f) => (
        <li>
          <span class="when">{f.anio}</span>
          <div><h3>{f.titulo}</h3><p>{f.lugar}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section id="contacto" class="section contact stage">
    <div class="contact-top fold">
      <span class="blob-shift" aria-hidden="true"><span class="hero-blob"></span></span>
      <h2>¿Tu idea necesita a alguien que la acompañe mientras evoluciona?</h2>
      <p>Busco roles de Senior Product / UX Designer o UX Design Engineer: formular el problema, investigarlo con quienes lo viven y acompañar cada decisión mientras la idea crece y cambia, también después de salir a producción.</p>
    </div>
    <div class="cta">
      <a class="btn btn-primary" href="https://www.linkedin.com/in/alejandro-p%C3%A9rez-2ba53415/" target="_blank" rel="noopener">Escríbeme por LinkedIn</a>
    </div>
  </section>
</Base>
